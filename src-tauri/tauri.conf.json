{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watch Time Stats",
  "version": "0.1.0",
  "identifier": "io.github.jriiik.youtubewatchstats",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Watch Time Stats",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 400,
        "preventOverflow": true,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#0B0E13"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.googleapis.com",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "script-src": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "jriiik",
    "homepage": "https://github.com/jriiik/youtube-hours-watched",
    "category": "Utility",
    "shortDescription": "See how much time you have spent watching YouTube",
    "longDescription": "Estimates how much time you have spent watching YouTube from the watch history in your Google Takeout export. Everything is worked out on your PC; only video IDs are sent to YouTube to look up video lengths.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "d9039721-a983-53bf-8032-63f3f5dcbc96"
      }
    }
  }
}
